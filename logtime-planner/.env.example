# ---- 42 intra API -------------------------------------------------------
# Create an app at https://profile.intra.42.fr/oauth/applications
FT_UID=
FT_SECRET=
FT_LOGIN=your_intra_login

# ---- Your week ----------------------------------------------------------
TIMEZONE=Asia/Singapore
WEEKLY_TARGET_HOURS=20
MONTHLY_TARGET_HOURS=90
# 0=Monday ... 6=Sunday. The day your campus resets the logtime week.
WEEK_START_DAY=0

# The earliest / latest AUTO-FILL may place a block. Does not affect what the
# grid displays — a 3am session still shows up, it just won't be scheduled.
DAY_WINDOW_START=08:00
DAY_WINDOW_END=23:00

# What the grid DRAWS. Widen to see overnight sessions; 24:00 means end of day.
GRID_START=00:00
GRID_END=24:00

# Auto-fill will never place a block shorter than this.
MIN_BLOCK_MINUTES=60

# Two separate ceilings. The first is the most auto-fill will ever suggest for
# one day; the second is the most a block you drag out yourself may add to a
# day, and is only there to catch a mis-drag. (These replace MAX_HOURS_PER_DAY.)
PLAN_MAX_HOURS_PER_DAY=14
MANUAL_MAX_HOURS_PER_DAY=24

# Treat a planned block as "at risk" if it starts within this many minutes
# of a busy event ending (travel time).
TRAVEL_BUFFER_MINUTES=30

# ---- Google calendars (read-only) --------------------------------------
# Calendar settings -> "Secret address in iCal format". Comma-separated.
GOOGLE_ICS_URLS=

# ---- iCloud (read busy + write plan) -----------------------------------
# App-specific password from https://appleid.apple.com -> Sign-In and Security
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
# Create this calendar by hand in Calendar.app first. The planner only ever
# writes here, and treats every OTHER iCloud calendar as busy time.
ICLOUD_PLAN_CALENDAR=42 Plan
# Optional: restrict busy-time reading to these calendar names.
ICLOUD_BUSY_CALENDARS=
